<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="frontend.MainPage"
             BackgroundColor="{StaticResource KwsPrimary}"
             Title="WildGuard Tracker">

    <RefreshView Command="{Binding LoadDataCommand}" IsRefreshing="{Binding IsRefreshing}">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- Header Banner -->
                <VerticalStackLayout Spacing="5" HorizontalOptions="Center" Margin="0,10,0,10">
                    <Label Text="KENYA WILDLIFE SERVICE" 
                           FontSize="20" 
                           FontFamily="MontserratBold" 
                           CharacterSpacing="2"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource KwsTextWhite}"/>
                    <Label Text="Wildlife Tracking &amp; Telemetry Dashboard" 
                           FontSize="13" 
                           Opacity="0.8"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <!-- Monitored Animals Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Monitored Animals" 
                           FontSize="18" 
                           FontFamily="MontserratBold"/>

                    <CollectionView ItemsSource="{Binding Animals}" HeightRequest="210">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame WidthRequest="180" 
                                       Padding="15" 
                                       BackgroundColor="{StaticResource KwsCardBackground}" 
                                       CornerRadius="12"
                                       HasShadow="True">
                                    <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontSize="16" 
                                               FontFamily="MontserratBold" 
                                               TextColor="{StaticResource KwsAccent}"/>
                                        <Label Text="{Binding Species}" 
                                               FontSize="13" 
                                               Opacity="0.9"/>
                                    </VerticalStackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Live Telemetry Feeds Section -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Live Telemetry Feeds" 
                           FontSize="18" 
                           FontFamily="MontserratBold"/>

                    <CollectionView ItemsSource="{Binding TelemetryLogs}" HeightRequest="280">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,4" 
                                       Padding="14" 
                                       BackgroundColor="{StaticResource KwsCardBackground}" 
                                       CornerRadius="10">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="{Binding AnimalId, StringFormat='Animal ID: {0}'}" 
                                                   FontFamily="MontserratBold" 
                                                   TextColor="{StaticResource KwsAccent}"
                                                   FontSize="14"/>
                                            <Label Text="{Binding Timestamp, StringFormat='Time: {0:yyyy-MM-dd HH:mm:ss}'}" 
                                                   FontSize="11" 
                                                   Opacity="0.7"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="2">
                                            <Label Text="{Binding Latitude, StringFormat='Lat: {0:F4}'}" FontSize="12"/>
                                            <Label Text="{Binding Longitude, StringFormat='Lng: {0:F4}'}" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>