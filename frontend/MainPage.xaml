<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:frontend.ViewModels"
             xmlns:converters="clr-namespace:frontend.Converters"
             x:Name="RootPage"
             x:Class="frontend.MainPage"
             BackgroundColor="{StaticResource KwsPrimary}"
             Title="WildGuard Tracker - Kenya Wildlife Service">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:AnimalImageConverter x:Key="AnimalImageConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- MAIN DASHBOARD CONTENT -->
        <RefreshView Command="{Binding LoadDataCommand}" 
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource KwsAccent}">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,32" Spacing="18">

                    <!-- Header Bar: KWS Emblem, Title, and Action Buttons -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1"
                                Padding="2"
                                BackgroundColor="#1A000000"
                                VerticalOptions="Center">
                            <Image Source="kws_logo.jpg" 
                                   HeightRequest="44" 
                                   WidthRequest="44" 
                                   Aspect="AspectFit" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="14,0,0,0">
                            <Label Text="WILDGUARD TRACKER" 
                                   FontSize="18" 
                                   FontFamily="MontserratBold" 
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource KwsTextWhite}"/>
                            <Label Text="Kenya Wildlife Service • National Spatial Command" 
                                   FontSize="11" 
                                   Opacity="0.8"/>
                        </VerticalStackLayout>

                        <!-- Top Action Controls: Register Collar & Refresh -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="#2D4A18" 
                                    StrokeShape="RoundRectangle 8" 
                                    Stroke="{StaticResource KwsAccent}"
                                    StrokeThickness="1"
                                    Padding="10,6" 
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRegistrationCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="+" FontSize="14" FontFamily="MontserratBold" TextColor="{StaticResource KwsAccent}" VerticalOptions="Center"/>
                                    <Label Text="Add Collar" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <Border BackgroundColor="#26000000" 
                                    StrokeShape="RoundRectangle 8" 
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    Padding="10,6" 
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoadDataCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="↻" FontSize="13" TextColor="{StaticResource KwsAccent}" VerticalOptions="Center"/>
                                    <Label Text="Sync" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Simulate GPS Movement Button -->
                            <Border BackgroundColor="#1E3A8A"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="#60A5FA"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SimulateTelemetryStepCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    
                                    <Label Text="Simulate GPS" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Real-Time Geofence Breach Alert Banner (HWC Early Warning) -->
                    <Border IsVisible="{Binding HasActiveAlerts}"
                            BackgroundColor="#8A1C14"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#FF5252"
                            StrokeThickness="1.5"
                            Padding="14,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="⚠️" FontSize="22" VerticalOptions="Center"/>
                            
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                <Label Text="HUMAN-WILDLIFE CONFLICT GEOFENCE BREACH" 
                                       FontFamily="MontserratBold" 
                                       FontSize="12" 
                                       TextColor="#FFD700" 
                                       CharacterSpacing="0.5"/>
                                <Label Text="{Binding ActiveIncidents[0].Message}" 
                                       FontSize="11" 
                                       TextColor="White" 
                                       Opacity="0.95"/>
                            </VerticalStackLayout>

                            <!-- Multi-Action Buttons -->
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                <!-- Dispatch Patrol Button -->
                                <Border BackgroundColor="#2E7D32"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="#4CAF50"
                                        StrokeThickness="1"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DispatchPatrolCommand}" 
                                                              CommandParameter="{Binding ActiveIncidents[0]}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="🚙 Dispatch" 
                                           FontFamily="MontserratBold" 
                                           FontSize="11" 
                                           TextColor="White" 
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Broadcast SMS Button -->
                                <Border BackgroundColor="#E65100"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="#FFB74D"
                                        StrokeThickness="1"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BroadcastSmsCommand}" 
                                                              CommandParameter="{Binding ActiveIncidents[0]}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="📲 SMS Farmers" 
                                           FontFamily="MontserratBold" 
                                           FontSize="11" 
                                           TextColor="White" 
                                           VerticalOptions="Center"/>
                                </Border>

                                <!-- Resolve Button -->
                                <Border BackgroundColor="#1565C0"
                                        StrokeShape="RoundRectangle 6"
                                        Stroke="#64B5F6"
                                        StrokeThickness="1"
                                        Padding="10,6"
                                        VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenResolveModalCommand}" 
                                                              CommandParameter="{Binding ActiveIncidents[0]}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="✓ Resolve" 
                                           FontFamily="MontserratBold" 
                                           FontSize="11" 
                                           TextColor="White" 
                                           VerticalOptions="Center"/>
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Status Subline -->
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Spacing="12">
                                <Label Text="{Binding ActiveIncidents[0].DispatchedPatrolUnit, StringFormat='Unit: {0}'}"
                                       FontSize="10"
                                       TextColor="#00E5FF"
                                       IsVisible="{Binding ActiveIncidents[0].IsDispatched}"/>
                                <Label Text="{Binding ActiveIncidents[0].SmsBroadcastDetails}"
                                       FontSize="10"
                                       TextColor="#FFD700"
                                       IsVisible="{Binding ActiveIncidents[0].IsSmsBroadcasted}"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <!-- SMS Broadcast Confirmation Toast Banner -->
                    <Border IsVisible="{Binding ShowSmsToast}"
                            BackgroundColor="#1B5E20"
                            StrokeShape="RoundRectangle 8"
                            Stroke="#66BB6A"
                            StrokeThickness="1"
                            Padding="12,8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="📲" FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding SmsNotificationToast}" FontSize="11" TextColor="White" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Kenya National Parks & Conservancies Filter Strip -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SECTOR FILTER" 
                               FontSize="10" 
                               FontFamily="MontserratBold" 
                               Opacity="0.75" 
                               CharacterSpacing="0.5"/>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <!-- All Kenya Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="All Kenya"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="All Kenya" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Amboseli NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Amboseli NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Amboseli NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Tsavo East NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Tsavo East NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Tsavo East NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Maasai Mara Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Maasai Mara"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Maasai Mara" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Nairobi NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Nairobi NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Nairobi NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Ol Pejeta Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Ol Pejeta"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Ol Pejeta" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Live Metrics Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Border Grid.Column="0" 
                                Padding="14,12" 
                                BackgroundColor="{StaticResource KwsCardBackground}" 
                                StrokeShape="RoundRectangle 10" 
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="MONITORED WILDLIFE" 
                                       FontSize="10" 
                                       Opacity="0.7" 
                                       FontFamily="MontserratBold"
                                       CharacterSpacing="0.5"/>
                                <Label Text="{Binding ActiveAnimalsCount, FallbackValue='0 Tracked'}" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold" 
                                       TextColor="{StaticResource KwsAccent}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" 
                                Padding="14,12" 
                                BackgroundColor="{StaticResource KwsCardBackground}" 
                                StrokeShape="RoundRectangle 10" 
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TELEMETRY LOGS" 
                                       FontSize="10" 
                                       Opacity="0.7" 
                                       FontFamily="MontserratBold"
                                       CharacterSpacing="0.5"/>
                                <Label Text="{Binding TelemetryLogsCount, FallbackValue='0 Recorded'}" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold" 
                                       TextColor="{StaticResource KwsTextWhite}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Interactive GIS Operations Map (Kenya Field Command) -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Interactive Spatial GIS Map" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold"
                                       TextColor="{StaticResource KwsTextWhite}"/>
                                <Label Text="Real-time collar fixes, national park boundaries &amp; buffer corridors" 
                                       FontSize="11" 
                                       Opacity="0.7"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" 
                                   Text="{Binding SelectedPark}" 
                                   FontSize="12" 
                                   FontFamily="MontserratBold" 
                                   TextColor="{StaticResource KwsAccent}" 
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="{StaticResource KwsCardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#26FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout>
                                <!-- Map WebView Component -->
                                <WebView Source="{Binding MapHtmlSource}"
                                         HeightRequest="290"
                                         HorizontalOptions="Fill" />

                                <!-- Map Legend Bar -->
                                <Border BackgroundColor="#22000000" Padding="12,8">
                                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#4CAF50" VerticalOptions="Center"/>
                                            <Label Text="National Park" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FF9800" VerticalOptions="Center"/>
                                            <Label Text="Buffer Corridor" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FFD700" VerticalOptions="Center"/>
                                            <Label Text="Collar Ping" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FF5252" VerticalOptions="Center"/>
                                            <Label Text="HWC Breach" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView WidthRequest="8" HeightRequest="8" Color="#00E5FF" VerticalOptions="Center"/>
                                            <Label Text="Patrol 4x4" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <BoxView WidthRequest="12" HeightRequest="2" Color="#00E5FF" VerticalOptions="Center"/>
                                            <Label Text="GPS Trail" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Monitored Wildlife Section -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Monitored Wildlife" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsTextWhite}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding FilteredAnimals.Count, StringFormat='{0} Active'}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding FilteredAnimals}" HeightRequest="270">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="195" 
                                            Padding="0" 
                                            BackgroundColor="{StaticResource KwsCardBackground}" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#25FFFFFF"
                                            StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectAnimalDetailCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="0">

                                            <!-- Animal Photo -->
                                            <Border StrokeShape="RoundRectangle 12,12,0,0"
                                                    Stroke="Transparent"
                                                    HeightRequest="120"
                                                    HorizontalOptions="Fill">
                                                <Image Source="{Binding Name, Converter={StaticResource AnimalImageConverter}}"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Border>

                                            <!-- Card Body -->
                                            <VerticalStackLayout Padding="12,8,12,10" Spacing="4">

                                                <!-- Species Chip & Battery Status -->
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <Border Grid.Column="0"
                                                            HorizontalOptions="Start"
                                                            BackgroundColor="#22000000"
                                                            StrokeShape="RoundRectangle 6"
                                                            Stroke="#22FFFFFF"
                                                            StrokeThickness="1"
                                                            Padding="7,2">
                                                        <Label Text="{Binding Species}"
                                                               FontSize="9"
                                                               TextColor="{StaticResource KwsTextWhite}"
                                                               Opacity="0.9"
                                                               LineBreakMode="TailTruncation"/>
                                                    </Border>
                                                    <Label Grid.Column="1"
                                                           Text="{Binding CollarBattery, StringFormat='🔋{0}%'}"
                                                           FontSize="9"
                                                           Opacity="0.8"
                                                           VerticalOptions="Center"/>
                                                </Grid>

                                                <!-- Animal Name -->
                                                <Label Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontFamily="MontserratBold"
                                                       TextColor="{StaticResource KwsAccent}"
                                                       LineBreakMode="TailTruncation"
                                                       MaxLines="1"/>

                                                <!-- Divider -->
                                                <BoxView HeightRequest="1" Color="#20FFFFFF" Margin="0,1"/>

                                                <!-- Sector & Collar -->
                                                <Label Text="{Binding ParkName, StringFormat='Sector: {0}'}"
                                                       FontSize="10"
                                                       TextColor="White"
                                                       Opacity="0.85"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding CollarId, StringFormat='Collar: {0}'}"
                                                       FontSize="9"
                                                       Opacity="0.55"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="📍 View Profile"
                                                       FontSize="9"
                                                       FontFamily="MontserratBold"
                                                       TextColor="#00E5FF"
                                                       Opacity="0.85"/>

                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Border StrokeShape="RoundRectangle 10" 
                                        Stroke="#1AFFFFFF" 
                                        StrokeThickness="1" 
                                        BackgroundColor="{StaticResource KwsCardBackground}" 
                                        Padding="24" 
                                        HorizontalOptions="Fill">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="No Collared Animals in Selected Sector" 
                                               FontFamily="MontserratBold" 
                                               FontSize="13" 
                                               TextColor="{StaticResource KwsTextWhite}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Tap 'All Kenya' or use '+ Add Collar' to deploy monitoring." 
                                               FontSize="11" 
                                               Opacity="0.7" 
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Recent Telemetry Feeds Section -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Recent Telemetry Logs" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsTextWhite}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding FilteredTelemetryLogs.Count, StringFormat='{0} Entries'}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding FilteredTelemetryLogs}" HeightRequest="260">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" 
                                            Padding="14,10" 
                                            BackgroundColor="{StaticResource KwsCardBackground}" 
                                            StrokeShape="RoundRectangle 10" 
                                            Stroke="#20FFFFFF" 
                                            StrokeThickness="1">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <!-- Log Identifier and Timestamp -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayAnimalId, StringFormat='Collar ID: #{0}'}" 
                                                       FontFamily="MontserratBold" 
                                                       TextColor="{StaticResource KwsAccent}"
                                                       FontSize="13"/>
                                                <Label Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm:ss} UTC'}" 
                                                       FontSize="11" 
                                                       Opacity="0.7"/>
                                            </VerticalStackLayout>

                                            <!-- GPS Coordinates Chip -->
                                            <Border Grid.Column="1"
                                                    BackgroundColor="#22000000"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#25FFFFFF"
                                                    StrokeThickness="1"
                                                    Padding="10,6"
                                                    VerticalOptions="Center">
                                                <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                                                    <Label Text="{Binding Latitude, StringFormat='Lat: {0:F4}°'}" 
                                                           FontSize="11" 
                                                           Opacity="0.85"
                                                           HorizontalTextAlignment="End"/>
                                                    <Label Text="{Binding Longitude, StringFormat='Lng: {0:F4}°'}" 
                                                           FontSize="11" 
                                                           Opacity="0.85"
                                                           HorizontalTextAlignment="End"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Border StrokeShape="RoundRectangle 10" 
                                        Stroke="#1AFFFFFF" 
                                        StrokeThickness="1" 
                                        BackgroundColor="{StaticResource KwsCardBackground}" 
                                        Padding="24" 
                                        HorizontalOptions="Fill">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="No Telemetry Feeds in Selected Sector" 
                                               FontFamily="MontserratBold" 
                                               FontSize="13" 
                                               TextColor="{StaticResource KwsTextWhite}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Awaiting satellite fix transmissions from field collars." 
                                               FontSize="11" 
                                               Opacity="0.7" 
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- MODAL OVERLAY: REGISTER WILDLIFE & DEPLOY COLLAR -->
        <Grid IsVisible="{Binding IsRegistrationModalOpen}"
              BackgroundColor="#CC000000"
              Padding="24"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border WidthRequest="380"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource KwsCardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource KwsAccent}"
                    StrokeThickness="1.5"
                    Padding="22">
                <VerticalStackLayout Spacing="14">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="DEPLOY FIELD COLLAR" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold" 
                                   TextColor="{StaticResource KwsAccent}"/>
                            <Label Text="Kenya Wildlife Service Animal Registry" 
                                   FontSize="11" 
                                   Opacity="0.7"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" 
                               Text="✕" 
                               FontSize="18" 
                               TextColor="White" 
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseRegistrationCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#33FFFFFF"/>

                    <!-- Animal Name Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ANIMAL / HERD NAME" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewAnimalName}" Placeholder="e.g. Mara Matriarch, Tsavo Bull" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Species Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SPECIES" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewAnimalSpecies}" Placeholder="African Elephant, Lion, Black Rhino" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Collar ID / IMEI Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="COLLAR DEVICE ID / IMEI" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewCollarId}" Placeholder="e.g. KWS-AMB-ELE08" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- National Park / Sector Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="KENYA PARK / SECTOR" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewParkName}" Placeholder="Amboseli NP, Tsavo East NP, Maasai Mara" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Modal Actions -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                        <Border Grid.Column="0"
                                BackgroundColor="#22000000"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#44FFFFFF"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseRegistrationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="White"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#556B2F"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource KwsAccent}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SubmitRegistrationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Deploy Collar" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource KwsAccent}"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- RESOLVE INCIDENT MODAL OVERLAY -->
        <Grid IsVisible="{Binding IsResolveModalOpen}"
              BackgroundColor="#CC000000"
              Padding="24"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border BackgroundColor="#2B3815"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource KwsAccent}"
                    StrokeThickness="1.5"
                    Padding="24"
                    WidthRequest="420"
                    VerticalOptions="Center"
                    HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="RESOLVE GEOFENCE INCIDENT" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold" 
                                   TextColor="{StaticResource KwsAccent}"/>
                            <Label Text="KWS Field Incident Resolution &amp; Ranger Report" 
                                   FontSize="11" 
                                   Opacity="0.7"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" 
                               Text="✕" 
                               FontSize="18" 
                               TextColor="White" 
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseResolveModalCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#33FFFFFF"/>

                    <!-- Field Resolution Notes Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="FIELD RANGER ACTION &amp; RESOLUTION NOTES" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,6">
                            <Editor Text="{Binding ResolutionNotes}" HeightRequest="80" TextColor="White" FontSize="12" AutoSize="TextChanges"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Modal Actions -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                        <Border Grid.Column="0"
                                BackgroundColor="#22000000"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#44FFFFFF"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseResolveModalCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="White"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#1565C0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#64B5F6"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SubmitResolveCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="✓ Confirm Resolution" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="White"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ════════════════════════════════════════════════════════════
             RIGHT-SIDE SLIDING ANIMAL DETAIL PANEL
             Triggered when user taps an animal card.
             IsVisible is toggled from code-behind via IsDetailPanelOpen.
             ════════════════════════════════════════════════════════════ -->

        <!-- Dim scrim behind panel -->
        <BoxView x:Name="DetailPanelScrim"
                 IsVisible="False"
                 Color="#99000000"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDetailPanelScrimTapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Sliding panel itself -->
        <Border x:Name="DetailPanel"
                IsVisible="False"
                HorizontalOptions="End"
                VerticalOptions="Fill"
                WidthRequest="320"
                BackgroundColor="#1A2E0A"
                StrokeShape="RoundRectangle 16,0,0,16"
                Stroke="{StaticResource KwsAccent}"
                StrokeThickness="1.5"
                TranslationX="320">
            <ScrollView>
                <VerticalStackLayout Spacing="0">

                    <!-- Panel Header -->
                    <Grid ColumnDefinitions="*, Auto" Padding="18,16,16,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                            <Label Text="ANIMAL PROFILE"
                                   FontSize="11"
                                   FontFamily="MontserratBold"
                                   CharacterSpacing="1"
                                   Opacity="0.65"
                                   TextColor="{StaticResource KwsTextWhite}"/>
                            <Label x:Name="DetailAnimalName"
                                   FontSize="20"
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsAccent}"
                                   LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1"
                               Text="✕"
                               FontSize="20"
                               TextColor="White"
                               VerticalOptions="Start"
                               Margin="0,4,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDetailPanelClose" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <!-- Large Animal Photo -->
                    <Border Margin="18,14,18,0"
                            StrokeShape="RoundRectangle 12"
                            Stroke="#33FFFFFF"
                            HeightRequest="200"
                            HorizontalOptions="Fill">
                        <Image x:Name="DetailAnimalPhoto"
                               Aspect="AspectFill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill" />
                    </Border>

                    <!-- Species Chip -->
                    <Border HorizontalOptions="Start"
                            Margin="18,12,18,0"
                            BackgroundColor="#22000000"
                            StrokeShape="RoundRectangle 20"
                            Stroke="{StaticResource KwsAccent}"
                            StrokeThickness="1"
                            Padding="12,5">
                        <Label x:Name="DetailSpecies"
                               FontSize="12"
                               FontFamily="MontserratBold"
                               TextColor="{StaticResource KwsAccent}"/>
                    </Border>

                    <BoxView HeightRequest="1" Color="#22FFFFFF" Margin="18,14,18,0"/>

                    <!-- Detail Stats Grid -->
                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto"
                          ColumnSpacing="12" RowSpacing="12"
                          Padding="18,14,18,0">

                        <!-- Collar ID -->
                        <Border Grid.Row="0" Grid.Column="0"
                                BackgroundColor="#15FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#20FFFFFF"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="COLLAR ID" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                                <Label x:Name="DetailCollarId" FontSize="12" FontFamily="MontserratBold" TextColor="White" LineBreakMode="TailTruncation"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sex -->
                        <Border Grid.Row="0" Grid.Column="1"
                                BackgroundColor="#15FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#20FFFFFF"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SEX" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                                <Label x:Name="DetailSex" FontSize="12" FontFamily="MontserratBold" TextColor="White"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Sector / Park -->
                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                BackgroundColor="#15FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#20FFFFFF"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="SECTOR / PARK" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                                <Label x:Name="DetailPark" FontSize="12" FontFamily="MontserratBold" TextColor="White" LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Battery -->
                        <Border Grid.Row="2" Grid.Column="0"
                                BackgroundColor="#15FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#20FFFFFF"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="BATTERY" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                                <Label x:Name="DetailBattery" FontSize="14" FontFamily="MontserratBold" TextColor="{StaticResource KwsAccent}"/>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Status -->
                        <Border Grid.Row="2" Grid.Column="1"
                                BackgroundColor="#15FFFFFF"
                                StrokeShape="RoundRectangle 10"
                                Stroke="#20FFFFFF"
                                Padding="12,10">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="STATUS" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                                <Label x:Name="DetailStatus" FontSize="12" FontFamily="MontserratBold" TextColor="#4CAF50"/>
                            </VerticalStackLayout>
                        </Border>

                    </Grid>

                    <!-- GPS Coordinates -->
                    <Border Margin="18,12,18,0"
                            BackgroundColor="#0DFFFFFF"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#20FFFFFF"
                            Padding="14,12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="LAST KNOWN POSITION" FontSize="9" FontFamily="MontserratBold" Opacity="0.6"/>
                            <Label x:Name="DetailCoordinates"
                                   FontSize="12"
                                   TextColor="#00E5FF"
                                   FontFamily="MontserratBold"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Action: View Trajectory -->
                    <Border Margin="18,14,18,28"
                            BackgroundColor="#2D4A18"
                            StrokeShape="RoundRectangle 10"
                            Stroke="{StaticResource KwsAccent}"
                            StrokeThickness="1"
                            Padding="14,12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnViewTrajectoryTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="📍" FontSize="16" VerticalOptions="Center"/>
                            <Label Text="View GPS Trajectory Trail"
                                   FontSize="13"
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsAccent}"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

    </Grid>
</ContentPage>