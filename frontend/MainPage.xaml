<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="frontend.MainPage"
             BackgroundColor="{StaticResource KwsPrimary}"
             Title="WildGuard Tracker - Kenya Wildlife Service">

    <Grid>
        <!-- MAIN DASHBOARD CONTENT -->
        <RefreshView Command="{Binding LoadDataCommand}" 
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="{StaticResource KwsAccent}">
            <ScrollView>
                <VerticalStackLayout Padding="18,16,18,32" Spacing="18">

                    <!-- Header Bar: KWS Emblem, Title, and Action Buttons -->
                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#33FFFFFF"
                                StrokeThickness="1"
                                Padding="2"
                                BackgroundColor="#1A000000"
                                VerticalOptions="Center">
                            <Image Source="kws_logo.jpg" 
                                   HeightRequest="44" 
                                   WidthRequest="44" 
                                   Aspect="AspectFit" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="14,0,0,0">
                            <Label Text="WILDGUARD TRACKER" 
                                   FontSize="18" 
                                   FontFamily="MontserratBold" 
                                   CharacterSpacing="1"
                                   TextColor="{StaticResource KwsTextWhite}"/>
                            <Label Text="Kenya Wildlife Service • National Spatial Command" 
                                   FontSize="11" 
                                   Opacity="0.8"/>
                        </VerticalStackLayout>

                        <!-- Top Action Controls: Register Collar & Refresh -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="#2D4A18" 
                                    StrokeShape="RoundRectangle 8" 
                                    Stroke="{StaticResource KwsAccent}"
                                    StrokeThickness="1"
                                    Padding="10,6" 
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRegistrationCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="+" FontSize="14" FontFamily="MontserratBold" TextColor="{StaticResource KwsAccent}" VerticalOptions="Center"/>
                                    <Label Text="Add Collar" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>

                            <Border BackgroundColor="#26000000" 
                                    StrokeShape="RoundRectangle 8" 
                                    Stroke="#33FFFFFF"
                                    StrokeThickness="1"
                                    Padding="10,6" 
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding LoadDataCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="↻" FontSize="13" TextColor="{StaticResource KwsAccent}" VerticalOptions="Center"/>
                                    <Label Text="Sync" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Real-Time Geofence Breach Alert Banner (HWC Early Warning) -->
                    <Border IsVisible="{Binding HasActiveAlerts}"
                            BackgroundColor="#8A1C14"
                            StrokeShape="RoundRectangle 10"
                            Stroke="#FF5252"
                            StrokeThickness="1.5"
                            Padding="14,12">
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" ColumnSpacing="12" RowSpacing="6">
                            <Label Grid.Row="0" Grid.Column="0" Text="⚠️" FontSize="20" VerticalOptions="Center"/>
                            
                            <VerticalStackLayout Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="HUMAN-WILDLIFE CONFLICT GEOFENCE BREACH" 
                                       FontFamily="MontserratBold" 
                                       FontSize="12" 
                                       TextColor="#FFD700" 
                                       CharacterSpacing="0.5"/>
                                <Label Text="Elephant detected past Amboseli boundary into Kimana community agriculture buffer." 
                                       FontSize="11" 
                                       TextColor="White" 
                                       Opacity="0.95"/>
                            </VerticalStackLayout>

                            <Border Grid.Row="0" Grid.Column="2"
                                    BackgroundColor="#2E7D32"
                                    StrokeShape="RoundRectangle 6"
                                    Stroke="#4CAF50"
                                    StrokeThickness="1"
                                    Padding="10,6"
                                    VerticalOptions="Center">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding DispatchPatrolCommand}" 
                                                          CommandParameter="{Binding ActiveIncidents[0]}" />
                                </Border.GestureRecognizers>
                                <Label Text="Dispatch Patrol" 
                                       FontFamily="MontserratBold" 
                                       FontSize="11" 
                                       TextColor="White" 
                                       VerticalOptions="Center"/>
                            </Border>

                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="Immediate dispatch recommendation: KWS Sector Alpha Quick-Response Unit"
                                   FontSize="10"
                                   Opacity="0.8"/>
                        </Grid>
                    </Border>

                    <!-- Kenya National Parks & Conservancies Filter Strip -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="SECTOR FILTER" 
                               FontSize="10" 
                               FontFamily="MontserratBold" 
                               Opacity="0.75" 
                               CharacterSpacing="0.5"/>
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <!-- All Kenya Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="All Kenya"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="All Kenya" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Amboseli NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Amboseli NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Amboseli NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Tsavo East NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Tsavo East NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Tsavo East NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Maasai Mara Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Maasai Mara"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Maasai Mara" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Nairobi NP Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Nairobi NP"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Nairobi NP" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>

                                <!-- Ol Pejeta Chip -->
                                <Border Padding="12,6" 
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#33FFFFFF"
                                        StrokeThickness="1"
                                        BackgroundColor="{StaticResource KwsCardBackground}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectParkCommand}" CommandParameter="Ol Pejeta"/>
                                    </Border.GestureRecognizers>
                                    <Label Text="Ol Pejeta" FontSize="11" FontFamily="MontserratBold" TextColor="{StaticResource KwsTextWhite}"/>
                                </Border>
                            </HorizontalStackLayout>
                        </ScrollView>
                    </VerticalStackLayout>

                    <!-- Live Metrics Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <Border Grid.Column="0" 
                                Padding="14,12" 
                                BackgroundColor="{StaticResource KwsCardBackground}" 
                                StrokeShape="RoundRectangle 10" 
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="MONITORED WILDLIFE" 
                                       FontSize="10" 
                                       Opacity="0.7" 
                                       FontFamily="MontserratBold"
                                       CharacterSpacing="0.5"/>
                                <Label Text="{Binding ActiveAnimalsCount, FallbackValue='0 Tracked'}" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold" 
                                       TextColor="{StaticResource KwsAccent}"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" 
                                Padding="14,12" 
                                BackgroundColor="{StaticResource KwsCardBackground}" 
                                StrokeShape="RoundRectangle 10" 
                                Stroke="#22FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="TELEMETRY LOGS" 
                                       FontSize="10" 
                                       Opacity="0.7" 
                                       FontFamily="MontserratBold"
                                       CharacterSpacing="0.5"/>
                                <Label Text="{Binding TelemetryLogsCount, FallbackValue='0 Recorded'}" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold" 
                                       TextColor="{StaticResource KwsTextWhite}"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Interactive GIS Operations Map (Kenya Field Command) -->
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Interactive Spatial GIS Map" 
                                       FontSize="16" 
                                       FontFamily="MontserratBold"
                                       TextColor="{StaticResource KwsTextWhite}"/>
                                <Label Text="Real-time collar fixes, national park boundaries &amp; buffer corridors" 
                                       FontSize="11" 
                                       Opacity="0.7"/>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" 
                                   Text="{Binding SelectedPark}" 
                                   FontSize="12" 
                                   FontFamily="MontserratBold" 
                                   TextColor="{StaticResource KwsAccent}" 
                                   VerticalOptions="Center"/>
                        </Grid>

                        <Border BackgroundColor="{StaticResource KwsCardBackground}"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#26FFFFFF"
                                StrokeThickness="1">
                            <VerticalStackLayout>
                                <!-- Map WebView Component -->
                                <WebView Source="{Binding MapHtmlSource}"
                                         HeightRequest="290"
                                         HorizontalOptions="Fill" />

                                <!-- Map Legend Bar -->
                                <Border BackgroundColor="#22000000" Padding="12,8">
                                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#4CAF50" VerticalOptions="Center"/>
                                            <Label Text="National Park" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FF9800" VerticalOptions="Center"/>
                                            <Label Text="Buffer Corridor" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FFD700" VerticalOptions="Center"/>
                                            <Label Text="Collar Ping" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Ellipse WidthRequest="8" HeightRequest="8" Fill="#FF5252" VerticalOptions="Center"/>
                                            <Label Text="HWC Breach" FontSize="10" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Monitored Wildlife Section -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Monitored Wildlife" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsTextWhite}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding FilteredAnimals.Count, StringFormat='{0} Active'}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding FilteredAnimals}" HeightRequest="205">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border WidthRequest="185" 
                                            Padding="14" 
                                            BackgroundColor="{StaticResource KwsCardBackground}" 
                                            StrokeShape="RoundRectangle 12"
                                            Stroke="#25FFFFFF"
                                            StrokeThickness="1">
                                        <Grid RowDefinitions="Auto, *, Auto, Auto" RowSpacing="6">
                                            <!-- Species Chip & Battery Status -->
                                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
                                                <Border Grid.Column="0"
                                                        HorizontalOptions="Start"
                                                        BackgroundColor="#22000000"
                                                        StrokeShape="RoundRectangle 6"
                                                        Stroke="#22FFFFFF"
                                                        StrokeThickness="1"
                                                        Padding="8,3">
                                                    <Label Text="{Binding Species}" 
                                                           FontSize="10" 
                                                           TextColor="{StaticResource KwsTextWhite}"
                                                           Opacity="0.9"
                                                           LineBreakMode="TailTruncation"/>
                                                </Border>
                                                <Label Grid.Column="1" 
                                                       Text="{Binding CollarBattery, StringFormat='🔋{0}%'}" 
                                                       FontSize="10" 
                                                       Opacity="0.8" 
                                                       VerticalOptions="Center"/>
                                            </Grid>

                                            <!-- Animal Name -->
                                            <Label Grid.Row="1"
                                                   Text="{Binding Name}" 
                                                   FontSize="15" 
                                                   FontFamily="MontserratBold" 
                                                   TextColor="{StaticResource KwsAccent}"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center"/>

                                            <!-- Divider -->
                                            <BoxView Grid.Row="2" 
                                                     HeightRequest="1" 
                                                     Color="#20FFFFFF" 
                                                     Margin="0,2"/>

                                            <!-- Sector & Collar ID -->
                                            <VerticalStackLayout Grid.Row="3" Spacing="2">
                                                <Label Text="{Binding ParkName, StringFormat='Sector: {0}'}" 
                                                       FontSize="11" 
                                                       TextColor="White"
                                                       Opacity="0.9"
                                                       LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding CollarId, StringFormat='Collar: {0}'}" 
                                                       FontSize="10" 
                                                       Opacity="0.6"/>
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Border StrokeShape="RoundRectangle 10" 
                                        Stroke="#1AFFFFFF" 
                                        StrokeThickness="1" 
                                        BackgroundColor="{StaticResource KwsCardBackground}" 
                                        Padding="24" 
                                        HorizontalOptions="Fill">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="No Collared Animals in Selected Sector" 
                                               FontFamily="MontserratBold" 
                                               FontSize="13" 
                                               TextColor="{StaticResource KwsTextWhite}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Tap 'All Kenya' or use '+ Add Collar' to deploy monitoring." 
                                               FontSize="11" 
                                               Opacity="0.7" 
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- Recent Telemetry Feeds Section -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="Recent Telemetry Logs" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold"
                                   TextColor="{StaticResource KwsTextWhite}"
                                   VerticalOptions="Center"/>
                            <Label Grid.Column="1"
                                   Text="{Binding FilteredTelemetryLogs.Count, StringFormat='{0} Entries'}"
                                   FontSize="12"
                                   Opacity="0.75"
                                   VerticalOptions="Center"/>
                        </Grid>

                        <CollectionView ItemsSource="{Binding FilteredTelemetryLogs}" HeightRequest="260">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,4" 
                                            Padding="14,10" 
                                            BackgroundColor="{StaticResource KwsCardBackground}" 
                                            StrokeShape="RoundRectangle 10" 
                                            Stroke="#20FFFFFF" 
                                            StrokeThickness="1">
                                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                            <!-- Log Identifier and Timestamp -->
                                            <VerticalStackLayout Grid.Column="0" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayAnimalId, StringFormat='Collar ID: #{0}'}" 
                                                       FontFamily="MontserratBold" 
                                                       TextColor="{StaticResource KwsAccent}"
                                                       FontSize="13"/>
                                                <Label Text="{Binding Timestamp, StringFormat='{0:yyyy-MM-dd HH:mm:ss} UTC'}" 
                                                       FontSize="11" 
                                                       Opacity="0.7"/>
                                            </VerticalStackLayout>

                                            <!-- GPS Coordinates Chip -->
                                            <Border Grid.Column="1"
                                                    BackgroundColor="#22000000"
                                                    StrokeShape="RoundRectangle 6"
                                                    Stroke="#25FFFFFF"
                                                    StrokeThickness="1"
                                                    Padding="10,6"
                                                    VerticalOptions="Center">
                                                <VerticalStackLayout Spacing="2" HorizontalOptions="End">
                                                    <Label Text="{Binding Latitude, StringFormat='Lat: {0:F4}°'}" 
                                                           FontSize="11" 
                                                           Opacity="0.85"
                                                           HorizontalTextAlignment="End"/>
                                                    <Label Text="{Binding Longitude, StringFormat='Lng: {0:F4}°'}" 
                                                           FontSize="11" 
                                                           Opacity="0.85"
                                                           HorizontalTextAlignment="End"/>
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                            <CollectionView.EmptyView>
                                <Border StrokeShape="RoundRectangle 10" 
                                        Stroke="#1AFFFFFF" 
                                        StrokeThickness="1" 
                                        BackgroundColor="{StaticResource KwsCardBackground}" 
                                        Padding="24" 
                                        HorizontalOptions="Fill">
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="No Telemetry Feeds in Selected Sector" 
                                               FontFamily="MontserratBold" 
                                               FontSize="13" 
                                               TextColor="{StaticResource KwsTextWhite}"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="Awaiting satellite fix transmissions from field collars." 
                                               FontSize="11" 
                                               Opacity="0.7" 
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Border>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- MODAL OVERLAY: REGISTER WILDLIFE & DEPLOY COLLAR -->
        <Grid IsVisible="{Binding IsRegistrationModalOpen}"
              BackgroundColor="#CC000000"
              Padding="24"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">
            <Border WidthRequest="380"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="{StaticResource KwsCardBackground}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource KwsAccent}"
                    StrokeThickness="1.5"
                    Padding="22">
                <VerticalStackLayout Spacing="14">
                    <!-- Modal Header -->
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="DEPLOY FIELD COLLAR" 
                                   FontSize="16" 
                                   FontFamily="MontserratBold" 
                                   TextColor="{StaticResource KwsAccent}"/>
                            <Label Text="Kenya Wildlife Service Animal Registry" 
                                   FontSize="11" 
                                   Opacity="0.7"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" 
                               Text="✕" 
                               FontSize="18" 
                               TextColor="White" 
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseRegistrationCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#33FFFFFF"/>

                    <!-- Animal Name Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="ANIMAL / HERD NAME" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewAnimalName}" Placeholder="e.g. Mara Matriarch, Tsavo Bull" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Species Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="SPECIES" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewAnimalSpecies}" Placeholder="African Elephant, Lion, Black Rhino" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Collar ID / IMEI Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="COLLAR DEVICE ID / IMEI" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewCollarId}" Placeholder="e.g. KWS-AMB-ELE08" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- National Park / Sector Input -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="KENYA PARK / SECTOR" FontSize="10" FontFamily="MontserratBold" Opacity="0.8"/>
                        <Border BackgroundColor="#1A000000" StrokeShape="RoundRectangle 8" Stroke="#33FFFFFF" Padding="8,2">
                            <Entry Text="{Binding NewParkName}" Placeholder="Amboseli NP, Tsavo East NP, Maasai Mara" TextColor="White" FontSize="13"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Modal Actions -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,8,0,0">
                        <Border Grid.Column="0"
                                BackgroundColor="#22000000"
                                StrokeShape="RoundRectangle 8"
                                Stroke="#44FFFFFF"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CloseRegistrationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Cancel" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="White"/>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="#556B2F"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{StaticResource KwsAccent}"
                                Padding="12,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SubmitRegistrationCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Deploy Collar" FontFamily="MontserratBold" FontSize="12" HorizontalTextAlignment="Center" TextColor="{StaticResource KwsAccent}"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>