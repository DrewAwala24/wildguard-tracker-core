# ============================================================
#  WildGuard Tracker — .gitignore
#  Excludes secrets, credentials, build artifacts, IDE files, OS noise
# ============================================================

# ─── Sensitive Configuration & Secrets ──────────────────────
# NEVER commit credentials, tokens, or environment files
backend/src/main/resources/application.properties
**/application.properties
!**/application.properties.template
application-*.properties
application-*.yml
application-*.yaml
secrets.properties
*.secret
*.secrets
.env
.env.*
*.env
credentials.json
token.json
local.settings.json
appsettings.Development.json
appsettings.Local.json
*.pem
*.key
*.pfx
*.p12
*.cert
*.crt

# ─── .NET / C# Build Artifacts & Binaries ───────────────────
# Covers frontend, desktop-csharp, and any future .NET projects
[Bb]in/
[Oo]bj/
**/bin/
**/obj/
frontend/bin/
frontend/obj/
desktop-csharp/**/bin/
desktop-csharp/**/obj/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates
project.lock.json
project.assets.json

# ─── Gradle & Java Build Artifacts ──────────────────────────
backend/.gradle/
backend/build/
backend/out/
.gradle/
build/
out/
target/
*.class
!gradle/wrapper/gradle-wrapper.jar
!backend/gradlew
!backend/gradlew.bat

# ─── IDE & Editor Configurations ─────────────────────────────
.vs/
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
*~

# ─── Logs & Diagnostics ─────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS Generated Files ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

