# ─────────────────────────────────────────────────────────────────────────────
#  WildGuard Tracker — Local Development Environment Variables
#
#  Copy this file to .env and fill in your own values.
#  The .env file is gitignored and should NEVER be committed.
#
#  Usage (PowerShell):
#    $env:SPRING_DATASOURCE_PASSWORD = "your_local_password"
#    ./gradlew bootRun
#
#  Usage (bash/zsh):
#    export SPRING_DATASOURCE_PASSWORD="your_local_password"
#    ./gradlew bootRun
# ─────────────────────────────────────────────────────────────────────────────

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kws_tracker_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_local_postgres_password_here
SPRING_JPA_DDL_AUTO=update
JASYPT_ENCRYPTOR_PASSWORD=any_local_secret_for_jasypt

# CARTO raster tile API key used by the backend map-tile proxy (/api/map/tiles/{z}/{x}/{y}.png).
# Never place this value in the MAUI app, HTML templates, or ViewModels.
CARTO_API_KEY=your_carto_api_key_here
